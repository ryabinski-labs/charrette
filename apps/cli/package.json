{
  "name": "charrette",
  "version": "0.1.0",
  "description": "Charrette CLI: a PRD in, reviewed pull requests out",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryabinski-labs/charrette.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/ryabinski-labs/charrette#readme",
  "bugs": {
    "url": "https://github.com/ryabinski-labs/charrette/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "bin": {
    "charrette": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@charrette/core": "workspace:*",
    "@charrette/dashboard": "workspace:*",
    "@charrette/shared": "workspace:*",
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
