{
  "name": "@charrette/dashboard",
  "version": "0.0.1",
  "description": "Live run dashboard for Charrette",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryabinski-labs/charrette.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/ryabinski-labs/charrette#readme",
  "bugs": {
    "url": "https://github.com/ryabinski-labs/charrette/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@charrette/core": "workspace:*",
    "@charrette/shared": "workspace:*",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
